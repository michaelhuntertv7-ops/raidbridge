{
  "name": "raidbridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "rehearsal": "tsx src/main.ts --rehearsal",
    "live": "tsx src/main.ts --live",
    "build": "tsc",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:browser": "playwright test",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "ws": "^8.18.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  }
}
